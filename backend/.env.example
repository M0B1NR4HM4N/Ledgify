# Copy to .env and fill in. Without a key, generation runs in grounded offline-stub mode.

# --- Provider: "anthropic" (default) or "gemini" ---
LEDGER_PROVIDER=anthropic

# --- Anthropic / Claude (native citations) ---
LEDGER_ANTHROPIC_API_KEY=
# LEDGER_ANSWER_MODEL=claude-opus-4-8

# --- Google Gemini (structured-output citations) ---
# Get an API key (starts with "AIza") at https://aistudio.google.com/apikey
# Note: gemini-2.5-pro is paid-tier only; gemini-2.5-flash works on the free tier.
GEMINI_API_KEY=
# LEDGER_GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_CLOUD_PROJECT=

# --- Optional retrieval overrides ---
# LEDGER_TOP_K=6
# LEDGER_REFUSAL_FLOOR=0.012
